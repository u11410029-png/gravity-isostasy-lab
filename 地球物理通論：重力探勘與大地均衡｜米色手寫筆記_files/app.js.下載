let curDerivationStep = 1;

function initDerivationStepper() {
  const prevBtn = document.getElementById('prev-step-btn');
  const nextBtn = document.getElementById('next-step-btn');
  const navItems = document.querySelectorAll('.step-nav');

  navItems.forEach(item => {
    item.addEventListener('click', () => {
      curDerivationStep = parseInt(item.getAttribute('data-step'), 10);
      renderDerivationStep();
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', () => {
      if (curDerivationStep > 1) {
        curDerivationStep--;
        renderDerivationStep();
      }
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', () => {
      if (curDerivationStep < derivationSteps.length) {
        curDerivationStep++;
        renderDerivationStep();
      }
    });
  }

  // Arrow-key navigation while the stepper is visible
  document.addEventListener('keydown', (e) => {
    const stepper = document.getElementById('stepper-container');
    if (!stepper || stepper.style.display === 'none') return;
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
    if (e.key === 'ArrowLeft' && curDerivationStep > 1) {
      curDerivationStep--;
      renderDerivationStep();
    } else if (e.key === 'ArrowRight' && curDerivationStep < derivationSteps.length) {
      curDerivationStep++;
      renderDerivationStep();
    }
  });

  renderDerivationStep();
}

function renderDerivationStep() {
  const box = document.getElementById('step-content-box');
  const indicator = document.getElementById('step-indicator');
  const prevBtn = document.getElementById('prev-step-btn');
  const nextBtn = document.getElementById('next-step-btn');
  const navItems = document.querySelectorAll('.step-nav');

  if (!box) return;

  const stepData = derivationSteps[curDerivationStep - 1];

  navItems.forEach(n => {
    const s = parseInt(n.getAttribute('data-step'), 10);
    n.classList.toggle('active', s === curDerivationStep);
  });

  if (prevBtn) prevBtn.disabled = curDerivationStep === 1;
  if (nextBtn) nextBtn.disabled = curDerivationStep === derivationSteps.length;
  if (indicator) indicator.textContent = `第 ${curDerivationStep} / ${derivationSteps.length} 步`;

  box.innerHTML = `
    <div style="margin-bottom:12px;">
      <span class="step-badge" style="background:var(--chalk-yellow); color:#fff8e8;">STEP ${stepData.step}</span>
      <h3 class="chalk-yellow font-kalam" style="font-size:1.4rem; display:inline; margin-left:8px;">${stepData.title}</h3>
      <p style="font-size:13.5px; color:var(--chalk-white-dim); margin-top:4px;">${stepData.subtitle}</p>
    </div>
    
    <div style="background:rgba(112,86,53,0.055); padding:16px; border-radius:8px; border:1px dashed rgba(93,74,50,0.2); margin:16px 0;">
      <div class="math-display" style="font-size:1.15rem;">${stepData.math}</div>
    </div>

    <div class="highlight-chalk" style="margin-top:14px;">
      <p style="color:var(--chalk-white); font-size:14.5px;">${stepData.notes}</p>
    </div>
  `;

  initMathRendering(box);
}

/* ================= 7. SIMULATOR A: AIRY ISOSTASY ================= */
function initAirySimulator() {
  const inpH = document.getElementById('input-h');
  const inpRc = document.getElementById('input-rhoc');
  const inpRm = document.getElementById('input-rhom');

  if (!inpH || !inpRc || !inpRm) return;

  [inpH, inpRc, inpRm].forEach(input => {
    input.addEventListener('input', updateAirySim);
  });

  updateAirySim();
}

function updateAirySim() {
  const inpH = document.getElementById('input-h');
  const inpRc = document.getElementById('input-rhoc');
  const inpRm = document.getElementById('input-rhom');

  const valH = document.getElementById('val-h');
  const valRc = document.getElementById('val-rhoc');
  const valRm = document.getElementById('val-rhom');

  const resRoot = document.getElementById('res-root');
  const resRatio = document.getElementById('res-ratio');
  const resTotal = document.getElementById('res-total');
  const canvas = document.getElementById('airy-interactive-canvas');

  if (!inpH || !canvas) return;

  const h = parseFloat(inpH.value);
  const rc = parseFloat(inpRc.value);
  const rm = parseFloat(inpRm.value);

  // Calculate Airy Root: r = [rc / (rm - rc)] * h
  const deltaRho = Math.max(rm - rc, 100);
  const ratio = rc / deltaRho;
  const rootM = ratio * h;
  const rootKm = rootM / 1000;
  const totalCrustKm = 30 + rootKm;

  valH.textContent = `${h.toLocaleString()} m (${(h / 1000).toFixed(2)} km)`;
  valRc.textContent = `${rc} kg/m³`;
  valRm.textContent = `${rm} kg/m³`;

  resRoot.textContent = `${rootM.toFixed(0)} m (${rootKm.toFixed(2)} km)`;
  resRatio.textContent = `${ratio.toFixed(2)} 倍`;
  resTotal.textContent = `${totalCrustKm.toFixed(2)} km`;

  // Draw Canvas
  const ctx = canvas.getContext('2d');
  const cw = canvas.width;
  const ch = canvas.height;

  ctx.clearRect(0, 0, cw, ch);

  // Mantle background
  ctx.fillStyle = '#f7efdf';
  ctx.fillRect(0, 0, cw, ch);

  const seaY = 110;
  const normMohoY = 200; // Represents 30km
  const kmScale = 2.0;   // pixels per km

  // Sea level dashed
  ctx.strokeStyle = 'rgba(93, 74, 50, 0.34)';
  ctx.setLineDash([4, 4]);
  ctx.beginPath();
  ctx.moveTo(10, seaY);
  ctx.lineTo(cw - 10, seaY);
  ctx.stroke();

  // Mountain shape
  const peakY = seaY - (h / 1000) * kmScale * 3.5;
  const rootY = normMohoY + rootKm * kmScale;

  // Crust block
  ctx.fillStyle = '#eadcc1';
  ctx.strokeStyle = '#5f7a4a';
  ctx.lineWidth = 2;

  ctx.beginPath();
  ctx.moveTo(30, seaY);
  ctx.lineTo(150, seaY);
  ctx.lineTo(250, peakY);
  ctx.lineTo(350, seaY);
  ctx.lineTo(470, seaY);
  ctx.lineTo(470, normMohoY);
  ctx.lineTo(370, normMohoY);
  ctx.lineTo(250, rootY);
  ctx.lineTo(130, normMohoY);
  ctx.lineTo(30, normMohoY);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // Normal Moho Reference
  ctx.strokeStyle = 'rgba(168, 93, 43, 0.35)';
  ctx.setLineDash([3, 3]);
  ctx.beginPath();
  ctx.moveTo(30, normMohoY);
  ctx.lineTo(cw - 30, normMohoY);
  ctx.stroke();
  ctx.setLineDash([]);

  // Labels
  ctx.fillStyle = '#4a3b2a';
  ctx.font = 'bold 12px Kalam';
  ctx.fillText('海平面 Sea-Level', 40, seaY - 8);

  ctx.fillStyle = '#a8641f';
  ctx.font = 'bold 13.5px Kalam';
  ctx.fillText(`▲ 山高 h = ${(h / 1000).toFixed(2)} km`, 180, Math.max(peakY - 10, 20));

  ctx.fillStyle = '#b4433a';
  ctx.fillText(`▼ 補償山根 r = ${rootKm.toFixed(2)} km`, 180, Math.min(rootY + 22, ch - 15));

  ctx.fillStyle = '#5f7a4a';
  ctx.font = '12px Kalam';
  ctx.fillText('正常地殼 (30 km)', 45, normMohoY - 10);
  ctx.fillText('地函 (Mantle)', 45, normMohoY + 45);
}

/* ================= 8. SIMULATOR B: GRAVITY CALCULATOR ================= */
function initGravityCalculator() {
  const btn = document.getElementById('run-calc-btn');
  if (!btn) return;

  btn.addEventListener('click', runGravityCalculation);
  runGravityCalculation();
}

function runGravityCalculation() {
  const h = parseFloat(document.getElementById('calc-h').value) || 0;
  const lat = parseFloat(document.getElementById('calc-lat').value) || 0;
  const gm = parseFloat(document.getElementById('calc-gm').value) || 0;
  const rho = parseFloat(document.getElementById('calc-rho').value) || 2.67;
  const gt = parseFloat(document.getElementById('calc-gt').value) || 0;
  const tide = parseFloat(document.getElementById('calc-tide').value) || 0;
  const output = document.getElementById('calc-steps-display');

  if (!output) return;

  // 1. Theoretical Normal Gravity (WGS84 formula approx)
  const rad = (lat * Math.PI) / 180;
  const sinLat = Math.sin(rad);
  const sin2Lat = Math.sin(2 * rad);
  const gn = 978032.7 * (1 + 0.0053024 * (sinLat ** 2) - 0.0000058 * (sin2Lat ** 2));

  // 2. Free-Air Correction: +0.3086 * h
  const dgFA = 0.3086 * h;

  // 3. Bouguer Plate Correction: 2 * pi * G * rho * h = 0.04193 * rho * h
  const dgBP = 0.04193 * rho * h;

  // 4. Free-Air Anomaly: gm + (dgFA + gt + tide) - gn
  const deltaGF = gm + (dgFA + gt + tide) - gn;

  // 5. Bouguer Anomaly: gm + (dgFA - dgBP + gt + tide) - gn
  const deltaGB = gm + (dgFA - dgBP + gt + tide) - gn;

  output.innerHTML = `
    <h4 class="chalk-yellow font-kalam" style="font-size:1.3rem; margin-bottom:12px;">
      📋 校正步驟詳細計算清單：
    </h4>

    <div style="display:flex; flex-direction:column; gap:10px;">
      <div style="background:rgba(112,86,53,0.05); padding:10px 14px; border-radius:6px;">
        <span class="chalk-cyan font-kalam">第 1 步：參考橢球面正常重力 gn(${lat}°)</span>
        <div class="c-math">$$g_n = ${gn.toFixed(3)} \\text{ mgal}$$</div>
      </div>

      <div style="background:rgba(112,86,53,0.05); padding:10px 14px; border-radius:6px;">
        <span class="chalk-cyan font-kalam">第 2 步：自由空間改正 (補回高度衰減)</span>
        <div class="c-math">$$\\Delta g_{\\text{FA}} = +0.3086 \\times ${h} = +${dgFA.toFixed(3)} \\text{ mgal}$$</div>
      </div>

      <div style="background:rgba(112,86,53,0.05); padding:10px 14px; border-radius:6px;">
        <span class="chalk-cyan font-kalam">第 3 步：布蓋平板改正 (扣除測站下方岩板引力)</span>
        <div class="c-math">$$\\Delta g_{\\text{BP}} = 0.04193 \\times ${rho} \\times ${h} = ${dgBP.toFixed(3)} \\text{ mgal}$$</div>
      </div>

      <div style="background:rgba(63,108,125,0.07); border:1.5px solid var(--chalk-cyan); padding:12px 14px; border-radius:8px;">
        <span class="chalk-cyan font-kalam" style="font-size:1.1rem;">★ 自由空間重力異常 (Free-Air Anomaly)：</span>
        <div class="c-math">$$\\begin{aligned}
        \\Delta g_F &= g_m + (\\Delta g_{\\text{FA}} + \\Delta g_T + \\Delta g_{\\text{tide}}) - g_n \\\\
        &= ${gm} + (${dgFA.toFixed(2)} + ${gt} + ${tide}) - ${gn.toFixed(2)} \\\\
        &= \\mathbf{${deltaGF >= 0 ? '+' : ''}${deltaGF.toFixed(2)}\\ \\text{mgal}}
        \\end{aligned}$$</div>
        <p style="font-size:13px; color:var(--chalk-white-dim); margin-top:4px;">
          (保留測站下方岩石質量，反映地表超額負載)
        </p>
      </div>

      <div style="background:rgba(244,220,139,0.2); border:1.5px solid var(--chalk-yellow); padding:12px 14px; border-radius:8px;">
        <span class="chalk-yellow font-kalam" style="font-size:1.1rem;">★ 布蓋重力異常 (Bouguer Anomaly)：</span>
        <div class="c-math">$$\\begin{aligned}
        \\Delta g_B &= g_m + (\\Delta g_{\\text{FA}} - \\Delta g_{\\text{BP}} + \\Delta g_T + \\Delta g_{\\text{tide}}) - g_n \\\\
        &= ${gm} + (${dgFA.toFixed(2)} - ${dgBP.toFixed(2)} + ${gt} + ${tide}) \\\\
        &\\qquad - ${gn.toFixed(2)} \\\\
        &= \\mathbf{${deltaGB >= 0 ? '+' : ''}${deltaGB.toFixed(2)}\\ \\text{mgal}}
        \\end{aligned}$$</div>
        <p style="font-size:13px; color:var(--chalk-white-dim); margin-top:4px;">
          (已扣除基準面以上地形與岩板引力，直接反映地下深部岩層密度分佈)
        </p>
      </div>
    </div>
  `;

  initMathRendering(output);
}

