    ctx.fillStyle = val === 0 ? '#a8641f' : '#8a755b';
    ctx.font = '11px Fira Code';
    ctx.fillText(`${val >= 0 ? '+' : ''}${val}`, 22, gy + 4);
  });
  ctx.setLineDash([]);
  ctx.fillStyle = '#8a755b';
  ctx.font = '11px Kalam';
  ctx.fillText('mgal', 20, 25);

  // Curve points: CP, WF, CR, LV, CoR
  const xCoords = [110, 250, 430, 570, 710];

