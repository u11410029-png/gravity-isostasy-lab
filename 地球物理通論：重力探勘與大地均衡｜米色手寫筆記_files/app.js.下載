  ctx.beginPath();
  ctx.moveTo(50, seaLevelY);
  ctx.lineTo(130, seaLevelY - 2);   // CP
  ctx.lineTo(260, seaLevelY - 20);  // WF
  ctx.lineTo(430, seaLevelY - 55);  // Central Range Peak
  ctx.lineTo(560, seaLevelY - 8);   // LV
  ctx.lineTo(680, seaLevelY - 24);  // CoR
  ctx.lineTo(790, seaLevelY + 18);  // Sea
  // Moho Bottom Line
  ctx.lineTo(790, 275);            // Oceanic Moho
  ctx.lineTo(660, 290);
  ctx.lineTo(560, 315);            // Under LV
  ctx.lineTo(430, 335);            // Under CR (~40-42km Moho)
  ctx.lineTo(260, 305);
  ctx.lineTo(50, 280);             // Continental Moho ~30km
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // Moho line dashed highlight (Red)
  ctx.strokeStyle = '#b4433a';
  ctx.lineWidth = 2;
  ctx.setLineDash([5, 4]);
  ctx.beginPath();
  ctx.moveTo(50, 280);
  ctx.lineTo(260, 305);
  ctx.lineTo(430, 335);
  ctx.lineTo(560, 315);
  ctx.lineTo(660, 290);
  ctx.lineTo(790, 275);
  ctx.stroke();
  ctx.setLineDash([]);

  // Geological Labels
  ctx.fillStyle = '#a8641f';
  ctx.font = 'bold 13px Kalam';
  ctx.fillText('歐亞大陸地殼 (Eurasian Crust)', 120, 255);
  
  ctx.fillStyle = '#b4433a';
  ctx.font = 'bold 12.5px Kalam';
  ctx.fillText('莫氏面 Moho (~40-45 km, 山根深度不足)', 280, 355);

