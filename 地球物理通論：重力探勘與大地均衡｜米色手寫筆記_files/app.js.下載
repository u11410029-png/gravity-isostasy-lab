/* ================= 1. MATH RENDERING HELPER ================= */
function initMathRendering(element = document.body) {
  if (typeof renderMathInElement === 'function') {
    renderMathInElement(element, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true }
      ],
      throwOnError: false
    });
  }
}

/* ================= 2. NAVIGATION ================= */
function initNavigation() {
  const navBtns = document.querySelectorAll('.nav-btn');
  const sections = document.querySelectorAll('.content-section');
  const contentTop = document.querySelector('.chalk-container');

  navBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      navBtns.forEach(b => b.classList.remove('active'));
      sections.forEach(s => s.classList.remove('active'));

      btn.classList.add('active');
      const targetId = btn.getAttribute('data-target');
      const targetSec = document.getElementById(targetId);
      if (targetSec) {
        targetSec.classList.add('active');
        // Redraw canvases when section becomes active to ensure correct dimensions
        if (targetId === 'sec-isostasy') {
          drawAiryModelDiagram();
          drawPrattModelDiagram();
        }
        if (targetId === 'sec-taiwan') updateTaiwanTransect();
        if (targetId === 'sec-lab') updateAirySim();
        // Re-render math in that section
        initMathRendering(targetSec);
        // Bring the new page into view, just below the header
        if (contentTop) {
          const top = contentTop.getBoundingClientRect().top + window.scrollY - 18;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    });
  });
}

/* ================= 3. AMBIENT CHALK DUST CANVAS ================= */
function initAmbientCanvas() {
  const canvas = document.getElementById('ambient-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  let width = canvas.width = window.innerWidth;
  let height = canvas.height = window.innerHeight;

  window.addEventListener('resize', () => {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
  });

  const particles = Array.from({ length: 45 }, () => ({
    x: Math.random() * width,
    y: Math.random() * height,
    radius: Math.random() * 1.5 + 0.5,
    alpha: Math.random() * 0.25 + 0.1,
    vx: (Math.random() - 0.5) * 0.25,
    vy: Math.random() * 0.3 + 0.1
  }));

  function animate() {
    ctx.clearRect(0, 0, width, height);
    particles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      if (p.y > height) { p.y = 0; p.x = Math.random() * width; }
      if (p.x < 0) p.x = width;
      if (p.x > width) p.x = 0;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(93, 74, 50, ${p.alpha})`;
      ctx.fill();
    });
    requestAnimationFrame(animate);
  }
  animate();
}

/* ================= 4. DIAGRAMS: AIRY & PRATT WITH AMPLE PADDING ================= */
function drawAiryModelDiagram() {
  const canvas = document.getElementById('airy-diagram');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;

  ctx.clearRect(0, 0, w, h);

  // Background Mantle
  ctx.fillStyle = '#f7efdf';
  ctx.fillRect(0, 0, w, h);

  const seaY = 70;
  const normCrustY = 145;
  const compY = 215;

  // Sea level dashed line
  ctx.strokeStyle = 'rgba(93, 74, 50, 0.42)';
  ctx.setLineDash([5, 4]);
  ctx.beginPath();
  ctx.moveTo(15, seaY);
  ctx.lineTo(w - 15, seaY);
  ctx.stroke();

  // Compensation depth dashed line
  ctx.strokeStyle = '#a8641f';
  ctx.beginPath();
  ctx.moveTo(15, compY);
  ctx.lineTo(w - 15, compY);
  ctx.stroke();
  ctx.setLineDash([]);

  // Crust block with clear steps matching PDF slide 2
  ctx.fillStyle = '#eadcc1';
  ctx.strokeStyle = '#3f6c7d';
  ctx.lineWidth = 2;

  ctx.beginPath();
  // Ocean bathymetry
  ctx.moveTo(25, seaY + 22);
  ctx.lineTo(115, seaY + 22);
  // Plain
  ctx.lineTo(115, seaY);
  ctx.lineTo(195, seaY);
  // Mountain h1
  ctx.lineTo(195, seaY - 45);
  ctx.lineTo(300, seaY - 45);
  // Mountain h2
  ctx.lineTo(300, seaY - 20);
  ctx.lineTo(390, seaY - 20);
  // Plain right
  ctx.lineTo(390, seaY);
  ctx.lineTo(495, seaY);
  // Right normal Moho
  ctx.lineTo(495, normCrustY);
  // Root r2
  ctx.lineTo(390, normCrustY);
  ctx.lineTo(390, normCrustY + 26);
  ctx.lineTo(300, normCrustY + 26);
  // Root r1 (deep root)
  ctx.lineTo(300, normCrustY + 55);
  ctx.lineTo(195, normCrustY + 55);
  // Plain Moho
  ctx.lineTo(195, normCrustY);
  ctx.lineTo(115, normCrustY);
  // Ocean Anti-root
  ctx.lineTo(115, normCrustY - 26);
  ctx.lineTo(25, normCrustY - 26);
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // Ocean Water fill
  ctx.fillStyle = 'rgba(63, 108, 125, 0.22)';
  ctx.fillRect(25, seaY, 90, 22);

  // Labels
  ctx.fillStyle = '#4a3b2a';
  ctx.font = 'bold 12px Kalam, LXGW WenKai TC, sans-serif';
  ctx.fillText('ocean (d)', 40, seaY + 16);
  ctx.fillText('sea-level', 125, seaY - 6);
  ctx.fillText('mountain (h₁)', 210, seaY - 50);
  ctx.fillText('h₂', 335, seaY - 25);

  ctx.fillStyle = '#a8641f';
  ctx.font = 'bold 15px Kalam, sans-serif';
  ctx.fillText('crust (ρc)', 240, normCrustY - 15);

  ctx.fillStyle = '#c17834';
  ctx.font = 'bold 13px Kalam, sans-serif';
  ctx.fillText('mantle (ρm)', 60, normCrustY + 35);
  ctx.fillText('root r₁', 235, normCrustY + 45);
  ctx.fillText('r₂', 335, normCrustY + 20);
  ctx.fillText('anti-root r₀', 35, normCrustY - 8);

  ctx.fillStyle = '#a8641f';
  ctx.font = '12.5px Kalam, sans-serif';
  ctx.fillText("C ────────────────── compensation depth ────────────────── C'", 40, compY + 16);
}

function drawPrattModelDiagram() {
  const canvas = document.getElementById('pratt-diagram');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;

  ctx.clearRect(0, 0, w, h);

  // Background Mantle
  ctx.fillStyle = '#f7efdf';
  ctx.fillRect(0, 0, w, h);

  const seaY = 75;
  const compY = 215;

  // Sea level dashed line
  ctx.strokeStyle = 'rgba(93, 74, 50, 0.42)';
  ctx.setLineDash([5, 4]);
  ctx.beginPath();
  ctx.moveTo(15, seaY);
  ctx.lineTo(w - 15, seaY);
  ctx.stroke();

  // Compensation depth dashed line
  ctx.strokeStyle = '#a8641f';
  ctx.beginPath();
  ctx.moveTo(15, compY);
  ctx.lineTo(w - 15, compY);
  ctx.stroke();
  ctx.setLineDash([]);

  // Pratt Blocks: Each column has bottom at compY, different density & height!
  const blocks = [
    { x: 25, w: 85, top: seaY + 22, color: '#e2d1b2', density: 'ρ₀ > ρc', sub: '(海盆較重)', label: 'ocean (d)' },
    { x: 110, w: 75, top: seaY, color: '#e9dcc3', density: 'ρc (正常)', sub: '', label: 'plain' },
    { x: 185, w: 105, top: seaY - 50, color: '#e2d1b2', density: 'ρ₁ < ρc', sub: '(高山最輕)', label: 'mountain h₁' },
    { x: 290, w: 95, top: seaY - 24, color: '#e9dcc3', density: 'ρ₂ < ρc', sub: '', label: 'mountain h₂' },
    { x: 385, w: 100, top: seaY, color: '#e9dcc3', density: 'ρc', sub: '(正常地殼)', label: 'crust' }
  ];

  ctx.lineWidth = 1.5;
  blocks.forEach(b => {
    ctx.fillStyle = b.color;
    ctx.strokeStyle = '#c17834';
    ctx.fillRect(b.x, b.top, b.w, compY - b.top);
    ctx.strokeRect(b.x, b.top, b.w, compY - b.top);

    // Labels inside block
    ctx.fillStyle = '#4a3b2a';
    ctx.font = 'bold 12px Kalam, LXGW WenKai TC, sans-serif';
    ctx.fillText(b.label, b.x + 8, b.top - 8);

    ctx.fillStyle = '#a8641f';
    ctx.font = 'bold 13px Kalam, LXGW WenKai TC, sans-serif';
    ctx.fillText(b.density, b.x + 12, (b.top + compY) / 2);
    if (b.sub) {
      ctx.fillStyle = '#8a755b';
      ctx.font = '11px Kalam, LXGW WenKai TC, sans-serif';
      ctx.fillText(b.sub, b.x + 12, (b.top + compY) / 2 + 16);
    }
  });

  // Ocean Water overlay
  ctx.fillStyle = 'rgba(63, 108, 125, 0.22)';
  ctx.fillRect(25, seaY, 85, 22);

  // Depth D indicator
  ctx.fillStyle = '#c17834';
  ctx.font = 'bold 12px Kalam, sans-serif';
  ctx.textAlign = 'right';
  ctx.fillText('Depth D', 508, (seaY + compY) / 2);
  ctx.textAlign = 'left';

  ctx.fillStyle = '#a8641f';
  ctx.font = '12.5px Kalam, sans-serif';
  ctx.fillText("C ────────────── 均一補償深度基準面 (Depth = D) ────────────── C'", 30, compY + 16);
}

