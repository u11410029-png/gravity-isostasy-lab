  ctx.lineWidth = 1.5;
  ctx.setLineDash([3, 3]);
  ctx.beginPath();
  ctx.moveTo(curX, 35);
  ctx.lineTo(curX, 365);
  ctx.stroke();
  ctx.setLineDash([]);
}

/* ================= 6. DERIVATION TABS & STEPPER (EXACT NOTEBOOK P.28) ================= */
function initDerivationTabs() {
  const tabNote = document.getElementById('tab-notebook-view');
  const tabStep = document.getElementById('tab-stepper-view');
  const tabScan = document.getElementById('tab-scan-view');
  const fullNote = document.getElementById('full-notebook-container');
  const stepper = document.getElementById('stepper-container');
  const scan = document.getElementById('scan-container');

  if (!tabNote || !tabStep || !fullNote || !stepper) return;

  const setTab = (activeTab) => {
    [tabNote, tabStep, tabScan].forEach(t => t && t.classList.toggle('active', t === activeTab));
    fullNote.style.display = activeTab === tabNote ? 'block' : 'none';
    stepper.style.display = activeTab === tabStep ? 'grid' : 'none';
    if (scan) scan.style.display = activeTab === tabScan ? 'block' : 'none';

    if (activeTab === tabNote) initMathRendering(fullNote);
    if (activeTab === tabStep) renderDerivationStep();
    if (activeTab === tabScan && scan) initMathRendering(scan);
  };

  tabNote.addEventListener('click', () => setTab(tabNote));
  tabStep.addEventListener('click', () => setTab(tabStep));
  if (tabScan) tabScan.addEventListener('click', () => setTab(tabScan));
}

