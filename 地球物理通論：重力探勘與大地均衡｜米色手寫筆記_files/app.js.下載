  const faValues = [20, 90, 280, 60, 95];
  // Bouguer values (-40, -65, -30, +25, +170)
  const baValues = [-40, -65, -30, 25, 170];

  // Draw Bouguer Curve (Yellow)
  ctx.strokeStyle = '#a8641f';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  xCoords.forEach((x, i) => {
    const y = mgalToY(baValues[i]);
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.stroke();

  // Draw Free-Air Curve (Red)
  ctx.strokeStyle = '#b4433a';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  xCoords.forEach((x, i) => {
    const y = mgalToY(faValues[i]);
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.stroke();

  // Legend at top
  ctx.fillStyle = '#b4433a';
  ctx.font = 'bold 12.5px Kalam';
  ctx.fillText('── 自由空間異常 (ΔgF, 中央山脈高達 +280~300 mgal)', 80, 25);
  ctx.fillStyle = '#a8641f';
  ctx.fillText('── 布蓋異常 (ΔgB)', 460, 25);

  // Section divider line
  ctx.strokeStyle = 'rgba(93, 74, 50, 0.2)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(30, 175);
  ctx.lineTo(w - 20, 175);
  ctx.stroke();

  // ================= 2. GEOLOGY & MOHO (y: 185 to 370) =================
  const seaLevelY = 215;

