  // Draw Cross-Section on Canvas
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;

  ctx.clearRect(0, 0, w, h);

  // Background
  ctx.fillStyle = '#fbf5e7';
  ctx.fillRect(0, 0, w, h);

  // ================= 1. GRAVITY PROFILE (y: 20 to 170) =================
  // Scale mapping: +350 mgal -> y=30, 0 mgal -> y=125, -100 mgal -> y=155
  function mgalToY(val) {
    // 0 mgal is at y = 125. 1 mgal = 0.30 px
    return 125 - val * 0.30;
