    });
  });

  const retryBtn = document.getElementById('retry-quiz-btn');
  if (retryBtn) {
    retryBtn.addEventListener('click', initQuiz);
  }
}

function handleQuizAnswer(qid, selectedOid) {
  const qData = quizQuestions[qid];
  const options = document.querySelectorAll(`.q-opt[data-qid="${qid}"]`);
  const feedback = document.getElementById(`feedback-${qid}`);

  // Disable further clicks on this question
  options.forEach(opt => opt.classList.add('disabled'));

  const isCorrect = selectedOid === qData.ans;
  if (isCorrect) userScore++;
  answeredCount++;

  options.forEach((opt, idx) => {
    if (idx === qData.ans) {
      opt.classList.add('correct');
    } else if (idx === selectedOid && !isCorrect) {
      opt.classList.add('wrong');
    }
  });

  if (feedback) {
    feedback.style.display = 'block';
    feedback.className = `quiz-feedback ${isCorrect ? 'feedback-correct' : 'feedback-wrong'}`;
    feedback.innerHTML = `
      <strong>${isCorrect ? '🎉 答對了！' : '❌ 答錯了！'}</strong> ${qData.explain}
    `;
  }

  // If all answered, show summary
  if (answeredCount === quizQuestions.length) {
    showQuizScore();
  }
}

function showQuizScore() {
  const scoreCard = document.getElementById('quiz-score-card');
  const scoreVal = document.getElementById('final-score');
  const comment = document.getElementById('score-comment');

  if (!scoreCard) return;

  scoreCard.style.display = 'block';
  scoreVal.textContent = userScore;

  let msg = '';
  if (userScore === 5) {
    msg = '🏆 太強了！滿分 5/5！你已經完全掌握了重力探勘與大地均衡的物理核心！';
  } else if (userScore >= 3) {
    msg = '👍 表現優異！觀念大致清晰，再稍微複習一下台灣重力構造與平板積分推導就更完美囉！';
  } else {
    msg = '💡 加油！建議再回顧上方的大地均衡模型與重力校正步驟，加深物理直覺！';
  }
  comment.innerHTML = `<p class="font-kalam chalk-yellow" style="font-size:1.25rem;">${msg}</p>`;
  scoreCard.scrollIntoView({ behavior: 'smooth' });
}

/* ================= 10. COPY GIT COMMANDS ================= */
function initCopyButton() {
  const copyBtn = document.querySelector('.copy-code-btn');
  if (!copyBtn) return;

  copyBtn.addEventListener('click', () => {
    const code = document.getElementById('git-commands');
    if (!code) return;

    navigator.clipboard.writeText(code.innerText).then(() => {
      const orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> 已複製！';
      setTimeout(() => {
        copyBtn.innerHTML = orig;
      }, 2000);
    });
  });
}
